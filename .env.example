USERNAMELOGIN=replace-with-clickhouse-username
PASSWORDLOGIN=replace-with-clickhouse-password
# Sending results is disabled by default. Set to true to enable ClickHouse.
SENDDATA=false
# Set to true to save JSON results in the log directory.
SAVELOGS=true
# Number of measurements per page.
COUNT_TESTING=2
LIGHTHOUSE_TIMEOUT_MS=120000
CLICKHOUSE_URL=https://clickhouse.example.com:8123